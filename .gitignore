# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
.vs/
*.swp
*~

# Logs / temp
*.log
*.tmp
*.bak

# Python 생성 캐시
__pycache__/
*.py[cod]

# 병합 충돌 잔여물
*.orig
*.rej

# 문서 변환 등 도구 의존성
node_modules/

# 개인 전용 파일
# 파일명에 .local 을 넣으면 커밋되지 않는다. 개인 백로그, 임시 메모 등에 쓴다.
# .claude/settings.local.json 과 CLAUDE.local.md 도 이 패턴에 걸린다.
# (.claude/settings.json 과 CLAUDE.md 는 팀 공용이므로 커밋한다)
*.local.*
CLAUDE.local.md

# API 키. 위의 *.local.* 에 이미 걸리지만, 유출되면 되돌릴 수 없으므로 명시한다.
*.key
elevenlabs.local.key


# ---------------------------------------------------------------------------
# Unity
# Unity 프로젝트는 Treeline/ 아래에 있다.
# 슬래시가 끝에만 있는 패턴(Library/ 등)은 어느 깊이에서든 걸리지만,
# 패턴 중간에 슬래시가 있으면 git 이 최상위에 고정시킨다. 그런 패턴은
# 앞에 **/ 를 붙여야 Treeline/Assets/... 까지 걸린다.
# ---------------------------------------------------------------------------

# 생성물 / 캐시
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.gradle/

# 자동 생성되는 솔루션 / 프로젝트 파일
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.slnf
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
crashlytics-build.properties

# Rider 자동 생성 플러그인
**/[Aa]ssets/Plugins/Editor/JetBrains*

# 에셋스토어 툴 (설치 시 생성)
**/[Aa]ssets/AssetStoreTools*

# 빌드 산출물 (gh-pages 브랜치로 별도 배포)
#
# IMPORTANT: Unity 빌드 출력 폴더는 반드시 Build/ 아래로 지정한다.
# 출력 경로는 빌드할 때 사람이 고르기 때문에 여기서 이름을 예측해 막을 수 없다.
# 다른 이름을 쓰면 WebGL 산출물 수백 MB 가 그대로 커밋 대상이 된다.
*.apk
*.aab
*.app
*.unitypackage

# Addressables 패킹 결과
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# .meta 는 대응하는 에셋이 무시될 때만 함께 무시한다
!*.meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------------------
# 제3자 에셋 원본
# 에셋스토어 표준 EULA는 원본 재배포를 금지하므로 저장소에 넣지 않는다.
# 빌드 산출물에 포함하는 것은 허용된 사용이다. 자세한 정책은 CLAUDE.md 참고.
# CC0 / MIT 등 재배포가 허용된 에셋은 이 폴더 밖에 두고 커밋한다.
# ---------------------------------------------------------------------------
**/[Aa]ssets/ThirdParty/
**/[Aa]ssets/ThirdParty.meta

# docs/ 에서 생성되는 PDF는 제출물이므로 무시하지 않고 커밋한다.

# Meshy 가 내려주는 원본 zip. 소품 30종이 565 MB 라 저장소에 넣지 않는다.
# 임포트해 정리한 FBX 와 512 텍스처만 Assets/Game/Props/ 에 커밋한다.
# IMPORTANT: Assets/ 아래에 두지 않는다. Unity 가 zip 마다 .meta 를 만들고
# Library 가 그만큼 부푼다.
**/ModelSources/meshygen*/

# MCP 로 찍은 스크린샷이 여기 쌓인다. 확인용이지 에셋이 아니므로 커밋하지 않는다.
# IMPORTANT: 위 `!*.meta` 보다 뒤에 있어야 한다. 나중 규칙이 이긴다.
**/[Aa]ssets/Screenshots/
**/[Aa]ssets/Screenshots.meta

# Blender 가 저장할 때마다 직전 판을 .blend1 로 남긴다. 원본이 아니라 백업이고
# 매 저장마다 10 MB 씩 새로 쌓이므로 커밋하지 않는다.
*.blend1

# 제출 PDF 빌드의 중간 산출물. PDF 만 커밋한다
docs/submission/*.html

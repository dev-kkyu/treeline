{
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/statusline.ps1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/block-force-push.ps1"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git push *)",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/block-force-push.ps1"
          }
        ]
      }
    ]
  }
}
